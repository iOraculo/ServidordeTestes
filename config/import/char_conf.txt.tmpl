// AureumRO Servidor de Testes — Char Server
userid: ${INTER_SERVER_USER}
passwd: ${INTER_SERVER_PASS}

server_name: ${SERVER_NAME}
wisp_server_name: AureumRO

login_ip: 127.0.0.1
login_port: ${LOGIN_PORT}
char_ip: ${SERVER_PUBLIC_IP}
char_port: ${CHAR_PORT}

// Desativa PIN na tela de seleção de personagem para agilizar testes
pincode_enabled: no
pincode_force: no

// Personagens novos nascem diretamente em Prontera, próximos ao Hub AureumRO e Laboratório 4Tools
start_point_pre: prontera,156,191
start_point: prontera,156,191
start_zeny: ${START_ZENY}

// Facilita exclusão de personagens de teste sem espera de 24h
char_del_delay: 0
char_del_level: 0

default_map: prontera
default_map_x: 156
default_map_y: 191

// Grava logs de console em /rathena/log/char-msg_log.log para o Painel Web
console_msg_log: 15
