# ==============================================================================
# AureumRO — Servidor de Testes (rAthena Pré-Renewal 13.3 + Painel Web)
# Copie para .env e ajuste conforme seu ambiente:  cp .env.example .env
# ==============================================================================

# Nome exibido no cliente Ragnarok e no Painel Web
SERVER_NAME=AureumRO Testes

# IP anunciado pelo char-server e map-server ao cliente Ragnarok
# Para jogar na mesma máquina (Windows/Linux local), mantenha 127.0.0.1
# Para jogar em rede local (LAN) ou VPS, informe o IP da máquina/VPS
SERVER_PUBLIC_IP=127.0.0.1

# Preset de rates inicial:
#   sandbox  -> 100x Base / 100x Job / 50x Drop + 1.000.000 zeny inicial (padrão)
#   aureumro ->   5x Base /   3x Job /  1x Drop (rates oficiais AureumRO)
SERVER_PRESET=sandbox

# Versão de cliente (PACKETVER) usada na compilação do rAthena
# Padrão recomendado sem anti-cheat: 20220406 (Ragexe 2022-04-06)
RATHENA_PACKETVER=20220406

# Desativa packet obfuscation para clientes Ragexe sem criptografia de pacotes (1 = desativar, 0 = manter)
RATHENA_DISABLE_OBFUSCATION=1

# Commit/branch do rAthena usado no build Docker (vazio ou "master" usa a versão mais recente)
RATHENA_GIT_REF=master

# Banco de dados MariaDB
DB_ROOT_PASSWORD=aureumro_root_pass
DB_NAME=ragnarok
DB_USER=ragnarok
DB_PASSWORD=aureumro_db_pass
DB_PORT=3306

# Credenciais internas entre login/char/map-server (conta account_id=1)
INTER_SERVER_USER=s1
INTER_SERVER_PASS=p1

# Contas padrão criadas no primeiro boot (altere se expor fora de localhost)
GM_ADMIN_USER=admin
GM_ADMIN_PASS=admin123
TESTER_USER=tester
TESTER_PASS=tester123

# Portas do servidor Ragnarok
LOGIN_PORT=6900
CHAR_PORT=6121
MAP_PORT=5121

# Painel Web Obsidiana & Ouro
WEBPANEL_PORT=8080
WEBPANEL_ALLOW_REGISTRATION=true
